[Unit]
Description=Cloudflare Tunnel for arabic-annotation.top
After=network-online.target nginx.service
Wants=network-online.target nginx.service

[Service]
Type=simple
User=huawei
ExecStart=/home/huawei/bin/cloudflared tunnel --protocol http2 run arabic-annotation
Restart=always
RestartSec=10
StandardOutput=append:/home/cjg/annotation_tool/tunnel.log
StandardError=append:/home/cjg/annotation_tool/tunnel.log

[Install]
WantedBy=multi-user.target
