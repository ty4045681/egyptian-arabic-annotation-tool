# Installed as /etc/annotation-production-backup.env, root:root, mode 0600.
# Local peer authentication; no production password or administrator DSN.
ANNOTATION_BACKUP_DATABASE=annotation_production_20260915
ANNOTATION_BACKUP_USER=annotation_backup
ANNOTATION_BACKUP_HOST=/var/run/postgresql
ANNOTATION_BACKUP_PORT=5432
ANNOTATION_BACKUP_DIR=/data/annotation/production-db-backups
ANNOTATION_BACKUP_RETENTION_DAYS=14
ANNOTATION_PG_BINDIR=/usr/lib/postgresql/18/bin
