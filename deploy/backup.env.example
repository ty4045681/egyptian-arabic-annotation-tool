# Copy to /etc/annotation-tool-backup.env, chmod 600.
ANNOTATION_BACKUP_DIR=/home/ck/annotation_db_backups
ANNOTATION_BACKUP_RETENTION_DAYS=14
# Optional but strongly recommended: a different physical disk, host, or
# object-store mount. Leave empty for a local-only backup under /home/ck.
ANNOTATION_BACKUP_REMOTE_DIR=
# Read-only role: SELECT on all tables AND sequences.
ANNOTATION_DB_DSN=postgresql://annotation_backup:CHANGE_ME@127.0.0.1:5432/annotation_tool
# Optional. If omitted, the script starts an isolated temporary PostgreSQL
# cluster for the restore check, so no production CREATEDB password is needed.
ANNOTATION_ADMIN_DSN=
