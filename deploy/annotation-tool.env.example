# Copy to /etc/annotation-tool.env, chmod 600, owner root:huawei.
# Use a dedicated least-privilege application role.
ANNOTATION_DB_DSN=postgresql://annotation_app:CHANGE_ME@127.0.0.1:5432/annotation_tool

# Admin dashboard. Generate a random key and store only its SHA-256 digest here.
# Keep the plaintext key in the team's password manager, never in this file.
ANNOTATION_ADMIN_KEY_ID=primary
ANNOTATION_ADMIN_KEY_SHA256=CHANGE_ME_64_HEX_SHA256
ANNOTATION_ADMIN_IDLE_SECONDS=1800
ANNOTATION_ADMIN_ABSOLUTE_SECONDS=28800
ANNOTATION_ADMIN_COOKIE_SECURE=true
ANNOTATION_ADMIN_COOKIE_NAME=__Host-admin_session
ANNOTATION_ADMIN_CSRF_COOKIE_NAME=__Host-admin_csrf
# Comma-separated direct proxies whose final X-Forwarded-For hop is trusted.
ANNOTATION_ADMIN_TRUSTED_PROXIES=127.0.0.1,::1
